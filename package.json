{
  "name": "@kryxjs/dsp",
  "version": "0.1.0",
  "description": "Audio DSP processing for the Kryx multimedia ecosystem — sample math, biquad filters, resampling (ESM + CJS + TypeScript)",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "preartifacts": "node scripts/create-npm-dirs.js",
    "artifacts": "napi artifacts",
    "build:native": "napi build --platform --release --cargo-cwd crates/dsp-node --js index.js --dts index.d.ts",
    "build:native:debug": "napi build --platform --cargo-cwd crates/dsp-node --js index.js --dts index.d.ts",
    "build:ts": "tsup && node scripts/fix-dts.js",
    "build": "npm run build:native && npm run build:ts",
    "build:debug": "npm run build:native:debug && npm run build:ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:rust && npm run test:vitest",
    "test:vitest": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run",
    "test:unit": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run test/unit",
    "test:integration": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run test/integration",
    "test:watch": "cross-env VITE_CJS_IGNORE_WARNING=true vitest",
    "test:rust": "cross-env CARGO_INCREMENTAL=0 cargo test --workspace --exclude dsp-node",
    "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:rust": "cargo fmt --all",
    "clippy": "cargo clippy --workspace --exclude dsp-node --all-targets -- -D warnings",
    "clean": "node -e \"const fs=require('fs');['dist','target','index.js','index.d.ts','npm'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}));fs.readdirSync('.').filter(f=>f.endsWith('.node')).forEach(f=>fs.rmSync(f,{force:true}));console.log('cleaned')\"",
    "version": "node scripts/sync-versions.js && napi version"
  },
  "files": [
    "dist/",
    "index.js",
    "index.d.ts",
    "README.md",
    "README.es.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "audio",
    "dsp",
    "filter",
    "biquad",
    "resample",
    "pipeline",
    "kryx",
    "rust",
    "napi",
    "native",
    "esm",
    "commonjs",
    "dual-package"
  ],
  "author": "Brashkie",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brashkie/kryx-dsp.git"
  },
  "bugs": {
    "url": "https://github.com/Brashkie/kryx-dsp/issues"
  },
  "homepage": "https://github.com/Brashkie/kryx-dsp#readme",
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "name": "kryx-dsp",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "optionalDependencies": {
    "@kryxjs/dsp-win32-x64-msvc": "0.1.0",
    "@kryxjs/dsp-win32-arm64-msvc": "0.1.0",
    "@kryxjs/dsp-darwin-x64": "0.1.0",
    "@kryxjs/dsp-darwin-arm64": "0.1.0",
    "@kryxjs/dsp-linux-x64-gnu": "0.1.0",
    "@kryxjs/dsp-linux-x64-musl": "0.1.0",
    "@kryxjs/dsp-linux-arm64-gnu": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@napi-rs/cli": "2.18.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^1.2.0",
    "cross-env": "^7.0.3",
    "tsup": "^8.0.1",
    "typescript": "^6.0.3",
    "vitest": "^1.2.0"
  }
}
